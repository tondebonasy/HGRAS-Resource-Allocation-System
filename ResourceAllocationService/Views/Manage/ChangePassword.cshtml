@model ResourceAllocationService.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}





<div class="auth-wrapper">
    <div class="auth-content">
        <div class="card">
            <div class="card-body text-left">
                <a class="auth-content-logo-header" href="~/Home/Index"><img src="~/Content/img/logo.png" alt=""></a>

                <h3 class="mb-4 auth-login-title"> Change Your  Password </h3>
                <hr />


                @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary("", new { @class = "text-danger" })
                    <div class="row">
                        @Html.LabelFor(m => m.OldPassword, new { @class = "col-md-12 col-form-label" })
                        <div class="col-md-12">
                            @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="row">
                        @Html.LabelFor(m => m.NewPassword, new { @class = "col-md-12 col-form-label" })
                        <div class="col-md-12">
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="row">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-12 col-form-label" })
                        <div class="col-md-12">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="row">
                        <br />
                        <div class="offset-md-2 col-md-12">
                            <input type="submit" value="Change password" class="btn btn-outline-dark" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>