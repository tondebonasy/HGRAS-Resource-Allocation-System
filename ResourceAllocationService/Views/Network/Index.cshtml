@using System.Collections.Generic
@using System.Data
@using System.Linq
@model Hgras.Network.NetworkWorkspace
@{
 ViewBag.Title="Hospital network";
 var groupAdmin=Model.Role=="GROUP_ADMIN";
 var managesStock=groupAdmin||Model.Role=="HOSPITAL_ADMIN"||Model.Role=="STORES";
 var requests=managesStock||Model.Role=="DEPARTMENT_MANAGER"||Model.Role=="CLINICAL";
 var tab=Request.QueryString["tab"]??"overview";
 var tabs=new[]{"overview","facilities","inventory","transfers","equipment","staff","capacity","procurement","notifications","audit","access"};
 if(!tabs.Contains(tab)){tab="overview";}
 var facilities=Model.Facilities==null?new DataRow[0]:Model.Facilities.Select();
 var assigned=facilities.Where(f=>groupAdmin||Model.FacilityId==(long)f["Id"]).ToArray();
 var stock=Model.Stock==null?new DataRow[0]:Model.Stock.Select();
 var transfers=Model.Transfers==null?new DataRow[0]:Model.Transfers.Select();
}

<main class="hgras-workspace">
 <header class="hgras-heading"><div><h1>Hospital network</h1></div><img src="@Url.Content("~/Content/img/hgras/logo.png")" alt="HGRAS Healthcare Network" /></header>
 @if(TempData["NetworkError"]!=null){<div class="hgras-message error" role="alert">@TempData["NetworkError"]</div>}
 @if(TempData["NetworkSuccess"]!=null){<div class="hgras-message" role="status">@TempData["NetworkSuccess"]</div>}
 @if(ViewBag.NetworkUnavailable==true){<section class="hgras-card" role="alert"><h2>The workspace is temporarily unavailable.</h2><a href="@Url.Action("Index",new{groupId=Model.GroupId})">Try again</a></section>}
 else {
 <div class="hgras-groupbar"><div><span class="hgras-eyebrow">YOUR HOSPITAL GROUP</span><h2>@(Model.GroupName??"Create your network")</h2></div>
 @if(Model.Groups.Rows.Count>0){<form method="get"><label for="group-switch">Switch group</label><select id="group-switch" name="groupId">@foreach(DataRow row in Model.Groups.Rows){<option value="@row["Id"]" selected="@((long)row["Id"]==Model.GroupId)">@row["Name"]</option>}</select><button type="submit">Open</button></form>}
 </div>
 if(User.IsInRole("ADMIN")){
 <details class="hgras-card compact"><summary>Create a hospital group</summary>
 @using(Html.BeginForm("CreateGroup","Network")){@Html.AntiForgeryToken()<label>Group name<input name="name" maxlength="160" required /></label><button type="submit">Create group</button>}
 </details>
 }
 if(Model.GroupId==0){<section class="hgras-card"><h2>Your network starts here.</h2><p>@(User.IsInRole("ADMIN")?"Create a group, add its hospitals and assign staff to begin sharing resources.":"Ask your group administrator to assign your registered account to a hospital and a network role.")</p><img class="hgras-empty-photo" src="@Url.Content("~/Content/img/hgras/hospital-exterior.jpg")" alt="Hospital exterior" /></section>}
 else {
 <div class="hgras-context"><span>@Model.Role.Replace('_',' ')</span><span>Retrieved @Model.RetrievedAtUtc.ToString("dd MMM yyyy HH:mm:ss") UTC</span><a href="@Url.Action("Index",new{groupId=Model.GroupId,tab})">Refresh data ↻</a></div>
 <nav class="hgras-tabs" aria-label="Network modules">@foreach(var item in tabs){if(item=="access"&&!groupAdmin){continue;}<a class="@(tab==item?"active":"")" href="@Url.Action("Index",new{groupId=Model.GroupId,tab=item})" aria-current="@(tab==item?"page":null)">@System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(item)</a>}</nav>
 if(tab=="overview"){
 <section class="hgras-metrics" aria-label="Network indicators"><article><span>Connected facilities</span><strong>@facilities.Length</strong><small>Within your hospital group</small></article><article><span>Transfers in progress</span><strong>@transfers.Count(r=>!new[]{"RECEIVED","REJECTED"}.Contains((string)r["Status"]))</strong><small>Across your permitted workspace</small></article><article><span>Awaiting approval</span><strong>@transfers.Count(r=>(string)r["Status"]=="REQUESTED")</strong><small>Review suitability before release</small></article><article class="attention"><span>Low-stock alerts</span><strong>@stock.Count(r=>(long)r["Quantity"]-(long)r["Reserved"]<=(long)r["ReorderLevel"])</strong><small>At or below the reorder threshold</small></article></section>

 <div class="hgras-chart-grid">
 @Html.Partial("_DashboardChart", new[]{"REQUESTED","APPROVED","DISPATCHED","RECEIVED","REJECTED"}.Select(stage=>new KeyValuePair<string,long>(stage,transfers.LongCount(r=>(string)r["Status"]==stage))).ToList(),new ViewDataDictionary{{"Title","Transfer status"},{"ChartType","doughnut"}})
 @Html.Partial("_DashboardChart", new[]{new KeyValuePair<string,long>("Shareable lots",stock.LongCount(r=>(long)r["Shareable"]>0)),new KeyValuePair<string,long>("Low-stock lots",stock.LongCount(r=>(long)r["Quantity"]-(long)r["Reserved"]<=(long)r["ReorderLevel"])),new KeyValuePair<string,long>("Reserved lots",stock.LongCount(r=>(long)r["Reserved"]>0)),new KeyValuePair<string,long>("Expired lots",stock.LongCount(r=>!r.IsNull("ExpiresOn")&&((DateTime)r["ExpiresOn"]).Date<=DateTime.UtcNow.Date))},new ViewDataDictionary{{"Title","Inventory health"},{"ChartType","bar"}})
 </div>
 <div class="hgras-two-col"><section class="hgras-card"><div class="hgras-section-title"><h2>Priority coordination</h2><a href="@Url.Action("Index",new{groupId=Model.GroupId,tab="transfers"})">All transfers →</a></div>
 @if(!transfers.Any()){<p class="hgras-empty">No transfers yet. Add facility stock and create your first sharing request.</p>}
 @foreach(var row in transfers.Take(6)){<article class="hgras-activity"><span class="hgras-priority @row["Priority"]">@row["Priority"]</span><div><h3>@row["ResourceName"]</h3><p>@row["FromName"] → @row["ToName"] · @row["Quantity"] @row["Unit"]</p></div><span class="hgras-status">@row["Status"]</span></article>}
 </section><section class="hgras-feature"><img src="@Url.Content("~/Content/img/hgras/hospital-exterior.jpg")" alt="Hospital facility" /><div><h2>Better equipped.<br />Better connected.</h2></div></section></div>
 <section class="hgras-card"><h2>Warnings that need attention</h2>@foreach(var row in stock.Where(r=>(long)r["Quantity"]-(long)r["Reserved"]<=(long)r["ReorderLevel"]||(!r.IsNull("ExpiresOn")&&(DateTime)r["ExpiresOn"]<=DateTime.UtcNow.AddDays(30)))){<p class="hgras-alert"><strong>@row["Name"] · @row["FacilityName"]</strong> — available after reservations: @((long)row["Quantity"]-(long)row["Reserved"]) @row["Unit"]; expiry: @(row.IsNull("ExpiresOn")?"not recorded":((DateTime)row["ExpiresOn"]).ToString("dd MMM yyyy"))</p>}</section>
 }
 if(tab=="facilities"){
 <section class="hgras-card"><h2>Hospitals in your group</h2><div class="hgras-facilities">@foreach(var row in facilities){<article><span class="hgras-facility-icon">✚</span><h3>@row["Name"]</h3><p>@row["Location"]</p><small>Responsible officer: @row["Officer"]</small></article>}</div></section>
 if(groupAdmin){<section class="hgras-card"><h2>Add a hospital facility</h2>@using(Html.BeginForm("AddFacility","Network")){@Html.AntiForgeryToken()<input type="hidden" name="groupId" value="@Model.GroupId"/><div class="hgras-form-grid"><label>Hospital name<input name="name" maxlength="160" required /></label><label>Location<input name="location" maxlength="200" required /></label><label>Responsible officer<input name="officer" maxlength="160" required /></label></div><button>Add facility</button>}</section>}
 if(groupAdmin||Model.Role=="HOSPITAL_ADMIN") {<section class="hgras-card"><h2>Departments and responsible officers</h2>@foreach(DataRow row in Model.Departments.Rows){<p><strong>@row["Name"]</strong> · @row["FacilityName"] · @row["Officer"]</p>}@using(Html.BeginForm("AddDepartment","Network")){@Html.AntiForgeryToken()<input type="hidden" name="groupId" value="@Model.GroupId"/><div class="hgras-form-grid"><label>Hospital<select name="facilityId" required>@foreach(var f in assigned){<option value="@f["Id"]">@f["Name"]</option>}</select></label><label>Department<input name="name" maxlength="160" required /></label><label>Responsible officer<input name="officer" maxlength="160" required /></label></div><button>Add department</button>}</section>}
 }
 if(tab=="inventory"){
 var search=Request.QueryString["resource"]??"";long requested;long.TryParse(Request.QueryString["quantity"],out requested);requested=Math.Max(1,requested);
 <section class="hgras-card"><div class="hgras-section-title"><div><h2>Find safely shareable resources</h2></div><a href="@Url.Action("Report",new{groupId=Model.GroupId})">Export stock CSV ↓</a></div><form method="get"><input type="hidden" name="groupId" value="@Model.GroupId"/><input type="hidden" name="tab" value="inventory"/><div class="hgras-form-grid"><label>Resource search<input name="resource" value="@search" placeholder="e.g. Oxygen cylinders" /></label><label>Units needed<input name="quantity" type="number" min="1" value="@requested" /></label></div><button>Find available stock</button></form></section>
 <section class="hgras-card"><div class="hgras-table-wrap"><table><thead><tr><th>Resource / hospital</th><th>Lot / expiry</th><th>On hand</th><th>Reserved</th><th>Safe reserve</th><th>Shareable</th><th>Last recorded</th></tr></thead><tbody>
 @foreach(var row in stock.Where(r=>((string)r["Name"]).IndexOf(search,StringComparison.OrdinalIgnoreCase)>=0&&(search==""||(long)r["Shareable"]>=requested)).OrderBy(r=>r.IsNull("ExpiresOn")?DateTime.MaxValue:(DateTime)r["ExpiresOn"])){
 <tr><td><strong>@row["Name"]</strong><small>@row["FacilityName"] · @row["Category"] · @row["Unit"]</small><small>@row["Handling"]</small></td><td>@row["Batch"]<small>@(row.IsNull("ExpiresOn")?"No expiry recorded":((DateTime)row["ExpiresOn"]).ToString("dd MMM yyyy"))</small></td><td>@row["Quantity"]</td><td>@row["Reserved"]</td><td>@row["MinimumReserve"]</td><td><strong>@row["Shareable"]</strong></td><td>@(((DateTime)row["UpdatedAtUtc"]).ToString("dd MMM HH:mm")) UTC @if((DateTime)row["UpdatedAtUtc"]<DateTime.UtcNow.AddHours(-24)){<small style="color:#b57830">Over 24h old · verify count</small>}</td></tr>
 }</tbody></table></div></section>
 if(managesStock){<details class="hgras-card"><summary>Record a stock lot</summary>@using(Html.BeginForm("AddStock","Network")){@Html.AntiForgeryToken()<input type="hidden" name="groupId" value="@Model.GroupId"/><div class="hgras-form-grid"><label>Hospital<select name="facilityId">@foreach(var f in assigned){<option value="@f["Id"]">@f["Name"]</option>}</select></label><label>Resource name<input name="name" maxlength="160" required /></label><label>Category<select name="category"><option>Supply</option><option>Medicine</option><option>Equipment</option><option>Consumable</option></select></label><label>Unit<input name="unit" maxlength="32" placeholder="cylinders, boxes, units" required /></label><label>Quantity<input name="quantity" type="number" min="0" required /></label><label>Minimum safe reserve<input name="minimum" type="number" min="0" value="0" required /></label><label>Reorder level<input name="reorder" type="number" min="0" value="0" required /></label><label>Batch<input name="batch" maxlength="80" /></label><label>Expiry date<input name="expires" type="date" /></label><label>Storage / handling<input name="handling" maxlength="200" /></label></div><button>Save stock lot</button>}</details>}
 }
 if(tab=="inventory"&&managesStock){<details class="hgras-card"><summary>Reconcile or replenish a stock lot</summary>@using(Html.BeginForm("ReconcileStock","Network")){@Html.AntiForgeryToken()<input type="hidden" name="groupId" value="@Model.GroupId"/><div class="hgras-form-grid"><label>Stock lot<select name="stockId" required>@foreach(var r in stock.Where(r=>groupAdmin||Model.FacilityId==(long)r["FacilityId"])){<option value="@r["Id"]">#@r["Id"] · @r["Name"] · @r["FacilityName"] · on hand @r["Quantity"]</option>}</select></label><label>Expected current count<input name="expected" type="number" min="0" required /></label><label>New verified count<input name="quantity" type="number" min="0" required /></label><label>Minimum safe reserve<input name="minimum" type="number" min="0" required /></label><label>Reorder level<input name="reorder" type="number" min="0" required /></label></div><label>Reason / replenishment reference<input name="note" maxlength="500" required /></label><button>Save reconciliation</button>}</details>}
 if(tab=="transfers"){
 if(requests){<details class="hgras-card"><summary>Request an inter-hospital transfer</summary>@using(Html.BeginForm("RequestTransfer","Network")){@Html.AntiForgeryToken()<input type="hidden" name="groupId" value="@Model.GroupId"/><div class="hgras-form-grid"><label>Supplying stock lot<select name="stockId" required>@foreach(var row in stock.Where(r=>(long)r["Shareable"]>0)){<option value="@row["Id"]">@row["Name"] · @row["FacilityName"] · @row["Shareable"] @row["Unit"] shareable · lot @row["Batch"]</option>}</select></label><label>Receiving hospital<select name="destination" required>@foreach(var f in assigned){<option value="@f["Id"]">@f["Name"]</option>}</select></label><label>Quantity<input name="quantity" type="number" min="1" required /></label><label>Priority<select name="priority"><option>Routine</option><option>Urgent</option><option>Critical</option></select></label></div><label>Reason, suitability and delivery requirements<textarea name="reason" maxlength="1000" required></textarea></label><button>Submit request</button>}</details>}
 <section class="hgras-card"><h2>Transfer coordination</h2>@if(!transfers.Any()){<p class="hgras-empty">No transfer requests have been recorded.</p>}
 @foreach(var row in transfers){var status=(string)row["Status"];var source=groupAdmin||Model.FacilityId==(long)row["FromFacilityId"];var receiver=groupAdmin||Model.FacilityId==(long)row["ToFacilityId"];var actions=managesStock?(status=="REQUESTED"&&source?new[]{"APPROVED","REJECTED"}:status=="APPROVED"&&source?new[]{"DISPATCHED","REJECTED"}:status=="DISPATCHED"&&receiver?new[]{"RECEIVED"}:new string[0]):new string[0];
 <article class="hgras-transfer"><div class="hgras-section-title"><div><span class="hgras-priority @row["Priority"]">@row["Priority"]</span><h3>#@row["Id"] · @row["ResourceName"]</h3><p>@row["FromName"] → @row["ToName"] · @row["Quantity"] @row["Unit"]</p></div><span class="hgras-status">@status</span></div><p>@row["Reason"]</p>@if(!row.IsNull("ReceivedQuantity")){<p><strong>Receipt reconciliation:</strong> @row["ReceivedQuantity"] of @row["Quantity"] units accepted.</p>}@if(!row.IsNull("Transport")){<p><strong>Transport:</strong> @row["Transport"]</p>}<small>Last recorded @(((DateTime)row["UpdatedAtUtc"]).ToString("dd MMM yyyy HH:mm")) UTC</small>
 @if(actions.Length>0){using(Html.BeginForm("Transition","Network")){@Html.AntiForgeryToken()<input type="hidden" name="groupId" value="@Model.GroupId"/><input type="hidden" name="transferId" value="@row["Id"]"/><input type="hidden" name="expected" value="@status"/><div class="hgras-form-grid"><label>Next action<select name="target">@foreach(var action in actions){<option>@action</option>}</select></label><label>Review, transport or full-receipt confirmation<input name="note" maxlength="500" required /></label></div>if(status=="REQUESTED"){<label class="hgras-check"><input type="checkbox" name="suitabilityReviewed" value="true"/> I am authorised to confirm suitability, storage requirements and delivery feasibility for approval.</label>}if(status=="DISPATCHED"){<label>Usable units actually received<input name="receivedQuantity" type="number" min="0" max="@row["Quantity"]" value="@row["Quantity"]" required /></label>}<button>Record action</button>}}
 </article>}</section>
 }
 if(new[]{"equipment","staff","capacity","procurement"}.Contains(tab)){
 var kind=tab=="equipment"?"Equipment":tab=="staff"?"Staff":tab=="capacity"?"Capacity":"Procurement";
 var role=kind=="Equipment"?"EQUIPMENT":kind=="Staff"?"HR":kind=="Capacity"?"CLINICAL":"PROCUREMENT";
 var canEdit=groupAdmin||Model.Role=="HOSPITAL_ADMIN"||Model.Role==role;
 <section class="hgras-card"><h2>@kind coordination</h2>
 <div class="hgras-table-wrap"><table><thead><tr><th>Record / hospital</th><th>Status</th><th>Available / total</th><th>Due</th><th>Details / recorded UTC</th></tr></thead><tbody>@foreach(DataRow row in Model.Operations.Select("Kind='"+kind+"'")){<tr><td><strong>#@row["Id"] · @row["Name"]</strong><small>@row["FacilityName"]</small></td><td>@row["Status"]</td><td>@row["Available"] / @row["Total"]</td><td>@(row.IsNull("DueOn")?"—":((DateTime)row["DueOn"]).ToString("dd MMM yyyy"))</td><td>@row["Notes"]<small>@(((DateTime)row["UpdatedAtUtc"]).ToString("dd MMM HH:mm"))</small></td></tr>}</tbody></table></div></section>
 if(canEdit){<section class="hgras-card"><h2>Add or update a @kind.ToLowerInvariant() record</h2>@using(Html.BeginForm("SaveOperation","Network")){@Html.AntiForgeryToken()<input type="hidden" name="groupId" value="@Model.GroupId"/><input type="hidden" name="kind" value="@kind"/><div class="hgras-form-grid"><label>Existing record ID (blank for new)<input name="id" type="number" min="1" /></label><label>Hospital<select name="facilityId">@foreach(var f in assigned){<option value="@f["Id"]">@f["Name"]</option>}</select></label><label>Name / role / service<input name="name" maxlength="160" required /></label><label>Status<input name="status" maxlength="32" placeholder="Available, Maintenance, Requested…" required /></label><label>Total units / positions<input name="total" type="number" min="0" required /></label><label>Available / outstanding units<input name="available" type="number" min="0" required /></label><label>Review / maintenance / delivery due<input name="due" type="date" /></label></div><label>Details, qualifications, location or responsible officer<textarea name="notes" maxlength="1000" required></textarea></label><button>Save record</button>}</section>}
 }
 if(tab=="notifications"){
 <section class="hgras-card"><h2>Hospital coordination inbox</h2>@if(Model.Notices.Rows.Count==0){<p class="hgras-empty">You have no unread transfer updates.</p>}@foreach(DataRow notice in Model.Notices.Rows){<article class="hgras-transfer"><h3>@notice["Subject"]</h3><p>@notice["Message"]</p><small>@(((DateTime)notice["CreatedAtUtc"]).ToString("dd MMM yyyy HH:mm")) UTC</small>@using(Html.BeginForm("Acknowledge","Network")){@Html.AntiForgeryToken()<input type="hidden" name="groupId" value="@Model.GroupId"/><input type="hidden" name="noticeId" value="@notice["Id"]"/><button>Mark as read</button>}</article>}</section>
 }
 if(tab=="audit"){
 <section class="hgras-card"><h2>Accountability at every handover</h2><div class="hgras-table-wrap"><table><thead><tr><th>When</th><th>Actor</th><th>Action / transfer</th><th>Note</th></tr></thead><tbody>@foreach(DataRow row in Model.Audit.Rows){<tr><td>@(((DateTime)row["OccurredAtUtc"]).ToString("dd MMM yyyy HH:mm:ss"))</td><td>@row["Actor"]</td><td>@row["Action"]<small>@(row.IsNull("TransferId")?"":"Transfer #"+row["TransferId"])</small></td><td>@row["Note"]</td></tr>}</tbody></table></div></section>
 }
 if(tab=="access"&&groupAdmin){
 <section class="hgras-card"><h2>Group membership and hospital permissions</h2><div class="hgras-table-wrap"><table><thead><tr><th>Account</th><th>Role</th><th>Hospital scope</th></tr></thead><tbody>@foreach(DataRow row in Model.Members.Rows){<tr><td>@row["Email"]</td><td>@row["Role"]</td><td>@(row.IsNull("FacilityId")?"Whole group":row["FacilityName"])</td></tr>}</tbody></table></div>
 @using(Html.BeginForm("AssignMember","Network")){@Html.AntiForgeryToken()<input type="hidden" name="groupId" value="@Model.GroupId"/><div class="hgras-form-grid"><label>Existing account email<input type="email" name="email" required /></label><label>Network role<select name="role">@foreach(var role in new[]{"GROUP_ADMIN","HOSPITAL_ADMIN","DEPARTMENT_MANAGER","STORES","CLINICAL","EQUIPMENT","HR","PROCUREMENT","AUDITOR"}){<option>@role</option>}</select></label><label>Hospital (ignored for group administrator)<select name="facilityId"><option value="">Whole group</option>@foreach(var f in facilities){<option value="@f["Id"]">@f["Name"]</option>}</select></label></div><button>Assign membership</button>}
 </section>
 }
 }
 }
</main>
