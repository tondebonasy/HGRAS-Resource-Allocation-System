@{
    ViewBag.Title = "Reset password confirmation";
}



<div class="auth-wrapper">
    <div class="auth-content">
        <div class="card">
            <div class="card-body text-left">
                <a class="auth-content-logo-header" href="~/Home/Index"><img src="~/Content/img/logo.png" alt=""></a>

                <h1 class="mb-4 auth-login-title"> Your password has been reset. Please @Html.ActionLink("click here to log in", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" }) </h1>

            </div>
        </div>
    </div>
</div>

