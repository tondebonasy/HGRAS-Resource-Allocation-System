@model IEnumerable<ResourceAllocationAdmin.Models.Request>
@{ViewBag.Title="Request queue";var requests=Model.ToList();}
<main class="container-xxl container-p-y"><div class="pgh-section-title"><div><p class="pgh-eyebrow">Hospital resource operations</p><h1>Request queue</h1><p class="pgh-muted">Open a request to review its resources, audit trail and permitted next action.</p></div><span class="org-badge">@requests.Count requests</span></div><section class="pgh-panel"><div class="pgh-field"><label for="queue-search">Find a request</label><input type="search" id="queue-search" placeholder="Search reference, organisation or stage" /></div><p class="pgh-muted" id="queue-results" role="status" style="font-size:12px">Showing @requests.Count requests</p><div class="table-responsive"><table class="table"><thead><tr><th>Request</th><th>Organisation</th><th>Submitted</th><th>Stage</th><th>Action</th></tr></thead><tbody>
@foreach(var item in requests){<tr data-queue-row><td><strong>#@item.Id</strong><div style="font-size:12px;max-width:280px;white-space:normal">@item.Description</div></td><td>@(item.Company==null?"Unassigned":item.Company.Name)</td><td>@(item.DateRequested.HasValue?item.DateRequested.Value.ToString("dd MMM yyyy"):"Not recorded")</td><td>@(item.RequestStage==null?"Unassigned":item.RequestStage.Name)</td><td><a class="pgh-text-link" href="@Url.Action("Details",new{id=item.Id})">Open →</a></td></tr>}
</tbody></table></div>@if(!requests.Any()){<p class="pgh-muted">No requests yet. New organisation submissions will appear here.</p>}</section></main>
@section scripts {<script>(function(){var search=document.getElementById('queue-search'),rows=Array.from(document.querySelectorAll('[data-queue-row]')),result=document.getElementById('queue-results');search.addEventListener('input',function(){var count=0,term=search.value.trim().toLowerCase();rows.forEach(function(row){row.hidden=!row.textContent.toLowerCase().includes(term);if(!row.hidden)count++;});result.textContent='Showing '+count+' of '+rows.length+' requests';});})();</script>}
