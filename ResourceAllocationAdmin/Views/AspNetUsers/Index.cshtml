@model IEnumerable<ResourceAllocationAdmin.Models.AspNetUser>
@{ViewBag.Title="User management";}
<main class="container-xxl container-p-y"><div class="pgh-section-title"><div><p class="pgh-eyebrow">Administrator access</p><h1>User management</h1><p class="pgh-muted">Manage contact details and role assignments without exposing authentication secrets.</p></div><a class="pgh-button secondary" href="@Url.Action("Index",new{hasrole=Request.QueryString["hasrole"]!="true"})">Switch user group</a></div><section class="pgh-panel"><div class="table-responsive"><table class="table"><thead><tr><th>Account</th><th>Organisation</th><th>Roles</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var user in Model){<tr><td>@user.Email</td><td>@(user.Company==null?"Hospital staff":user.Company.Name)</td><td>@String.Join(", ",user.AspNetRoles.Select(r=>r.Name))</td><td>@(user.LockoutEndDateUtc>DateTime.UtcNow?"Disabled / locked":"Active")</td><td><a href="@Url.Action("Details",new{id=user.Id})">Manage →</a></td></tr>}</tbody></table></div></section></main>
