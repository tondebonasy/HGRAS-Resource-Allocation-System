@model ResourceAllocationAdmin.Models.IndexViewModel
@{ViewBag.Title="My account";Layout="~/Views/Shared/EditsLayout.cshtml";}
<main class="pgh-shell pgh-form"><p class="pgh-eyebrow">Account settings</p><h1>Your account, in one place.</h1><p class="pgh-muted">@User.Identity.Name</p><section class="pgh-panel">@if(!String.IsNullOrWhiteSpace(ViewBag.StatusMessage as string)){<p role="status">@ViewBag.StatusMessage</p>}<h2 style="font-size:21px">Sign-in and profile</h2><p class="pgh-muted">Keep your password private and your contact details current.</p><div class="pgh-actions"><a class="pgh-button" href="@Url.Action(Model.HasPassword?"ChangePassword":"SetPassword")">@(Model.HasPassword?"Change password":"Set a password") →</a><a class="pgh-button secondary" href="@Url.Action("Index","Home")">Operations overview</a></div></section></main>
