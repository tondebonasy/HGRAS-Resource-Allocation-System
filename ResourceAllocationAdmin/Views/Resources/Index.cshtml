@model IEnumerable<ResourceAllocationAdmin.Models.Resource>
@{ViewBag.Title="Resource catalogue";var items=Model.ToList();}
<main class="container-xxl container-p-y"><div class="pgh-section-title"><div><p class="pgh-eyebrow">Available inventory</p><h1>Resource catalogue</h1><p class="pgh-muted">Available quantities exclude stock already reserved by approved requests.</p></div>@if(User.IsInRole("ADMIN")){<a class="pgh-button" href="@Url.Action("Create")">Add resource +</a>}</div><section class="pgh-panel"><div class="table-responsive"><table class="table"><thead><tr><th>Resource</th><th>Available stock</th><th>Stock status</th><th>Action</th></tr></thead><tbody>@foreach(var item in items){<tr><td><strong>@item.Name</strong><p class="pgh-muted" style="font-size:12px;margin:6px 0 0">@item.Description</p></td><td>@(item.Quantity??0)</td><td>@((item.Quantity??0)==0?"Out of stock":item.Quantity<=10?"Low stock":"Available")</td><td>@if(User.IsInRole("ADMIN")){<a href="@Url.Action("Edit",new{id=item.id})">Manage stock →</a>}else{<span class="pgh-muted">View only</span>}</td></tr>}</tbody></table></div>@if(!items.Any()){<p class="pgh-muted">The catalogue is empty. Add a resource to get started.</p>}</section></main>
