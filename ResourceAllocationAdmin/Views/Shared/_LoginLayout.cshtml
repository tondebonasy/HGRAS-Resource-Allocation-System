<!DOCTYPE html>
<html lang="en" class="light-style customizer-hide" dir="ltr" data-theme="theme-default" data-assets-path="@Url.Content("~/Content/assets/")">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewBag.Title | HGRAS Administration</title><link rel="icon" type="image/png" href="@Url.Content("~/Content/img/hgras/logo.png")" />
<link rel="stylesheet" href="~/Content/assets/vendor/fonts/boxicons.css" /><link rel="stylesheet" href="~/Content/assets/vendor/css/core.css" /><link rel="stylesheet" href="~/Content/assets/vendor/css/theme-default.css" /><link rel="stylesheet" href="~/Content/pgh-ui.css?v=20261021-hgras" />
<style>
.admin-auth{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;background:#fff}.admin-auth-story{background:#163b65;padding:8vw;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;color:#ccdae7}.admin-auth-story:after{content:'+';position:absolute;right:-90px;bottom:-130px;font-size:620px;font-weight:700;color:#ffffff04;line-height:1;pointer-events:none}.admin-auth-brand{display:flex;align-items:center;gap:14px;color:#fff;font-size:20px;font-weight:600}.admin-auth-brand span{display:grid;place-items:center;width:45px;height:45px;background:#087e8b;border-radius:12px;font-size:30px}.admin-auth-story h1{color:#fff;font-size:clamp(32px,3.8vw,54px);letter-spacing:-1.8px;line-height:1.15;margin:30px 0 23px}.admin-auth-story p{font-size:14px;line-height:1.9;max-width:400px;color:#c1d4e4}.admin-auth-story small{font-size:11px;color:#90b4cf}.admin-auth-form{display:flex;align-items:center;justify-content:center;padding:55px 35px}.admin-auth-inner{width:100%;max-width:380px}.admin-auth-inner h2{font-size:29px;color:#163b65;letter-spacing:-.7px;margin:20px 0 10px}.admin-auth-inner>p{color:#8a98a5;font-size:13px;margin-bottom:30px}.admin-auth-inner label{font-size:12px;color:#4a6276}.admin-auth-inner .btn{padding:13px;border-radius:8px}.admin-auth-inner input:not([type=checkbox]){min-height:47px}.admin-auth-security{font-size:10px;color:#8797a4;display:flex;align-items:center;gap:7px;border-top:1px solid #e7edf2;padding-top:22px;margin-top:30px}.admin-auth-eyebrow{font-size:10px;letter-spacing:1.8px;color:#087e8b;font-weight:700}@@media(max-width:850px){.admin-auth{grid-template-columns:1fr}.admin-auth-story{padding:35px;min-height:230px}.admin-auth-story h1{font-size:30px;margin-bottom:10px}.admin-auth-story p,.admin-auth-story small{display:none}.admin-auth-form{padding:35px 25px}.admin-auth-inner{max-width:430px}}
</style><script src="~/Content/assets/vendor/js/helpers.js"></script><script src="~/Content/assets/js/config.js"></script><link rel="stylesheet" href="@Url.Content("~/Content/hgras-charts.css")" /><script defer src="@Url.Content("~/Content/hgras-charts.js")"></script><link rel="stylesheet" href="@Url.Content("~/Content/hgras-network.css")" /><link rel="stylesheet" href="@Url.Content("~/Content/hgras-design.css?v=20261022")" /></head><body>
<main class="admin-auth"><section class="admin-auth-story"><a class="admin-auth-brand" href="@Url.Action("Index", "Home")"><img src="@Url.Content("~/Content/img/logo.png")" alt="HGRAS Healthcare Network logo" style="width:55px;height:64px;object-fit:contain;background:white;border-radius:9px;padding:3px" />HGRAS Resource Allocation</a><div><div style="font-size:10px;letter-spacing:2px;color:#7dc9cc">HOSPITAL GROUP RESOURCE ALLOCATION SYSTEM</div><h1>Every resource.<br />A better chance<br />to care.</h1></div><small>&copy; @DateTime.Today.Year HGRAS &middot; Hospital administration</small></section>
<section class="admin-auth-form"><div class="admin-auth-inner"><div class="admin-auth-eyebrow">ADMINISTRATION PORTAL</div><h2>@ViewBag.Title</h2>@RenderBody()<div class="admin-auth-security"><i class="bx bx-lock-alt"></i>Authorised hospital personnel only</div></div></section></main>
<script src="~/Content/assets/vendor/libs/jquery/jquery.js"></script><script src="~/Content/assets/vendor/libs/popper/popper.js"></script><script src="~/Content/assets/vendor/js/bootstrap.js"></script>
<script src="~/Content/assets/vendor/js/menu.js"></script><script src="~/Content/assets/js/main.js"></script>
@RenderSection("scripts", required: false)
</body></html>






