@if (Request.IsAuthenticated)
{
    <li class="nav-item navbar-dropdown dropdown-user dropdown">
        <button type="button" class="nav-link dropdown-toggle hide-arrow border-0 bg-transparent" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu for @User.Identity.Name" style="display:flex;align-items:center;gap:10px">
            <span class="d-none d-md-block" style="max-width:145px;overflow:hidden;text-overflow:ellipsis;font-size:12px;color:#345066">@User.Identity.Name</span>
            <span style="width:38px;height:38px;border-radius:11px;background:#e9f4f3;color:#087e8b;display:grid;place-items:center"><i class="bx bx-user" aria-hidden="true" style="font-size:23px"></i></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><div class="px-3 py-2"><strong style="display:block;font-size:12px;overflow-wrap:anywhere">@User.Identity.Name</strong><small class="text-muted">Administration account</small></div></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" href="@Url.Action("Index", "Manage")"><i class="bx bx-user me-2" aria-hidden="true"></i>My profile &amp; settings</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
                {
                    @Html.AntiForgeryToken()
                    <button class="dropdown-item" type="submit"><i class="bx bx-log-out me-2" aria-hidden="true"></i>Sign out</button>
                }
            </li>
        </ul>
    </li>
}

